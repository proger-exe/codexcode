{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@codex-code/core": ["packages/core/src/index.ts"],
      "@codex-code/core/lsp": ["packages/core/src/lsp/index.ts"],
      "@codex-code/ui": ["packages/ui/src/index.ts"],
      "@codex-code/templates": ["packages/templates/src/index.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
