{
  "name": "@codex-code/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Visual IDE shell for Codex CLI",
  "homepage": "https://github.com/proger-exe/codexcode",
  "author": {
    "name": "sh3lby.code",
    "email": "noreply@github.com"
  },
  "desktopName": "codex-code",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@codex-code/core": "file:../../packages/core",
    "@codex-code/ui": "file:../../packages/ui",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "dev.sh3lby.codexcode",
    "productName": "CodexCode",
    "executableName": "codex-code",
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "sh3lby.code",
      "syncDesktopName": true,
      "artifactName": "CodexCode-${version}-${arch}.${ext}"
    }
  }
}
